<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}SICOJEV{% endblock %}</title>

    <link rel="stylesheet" href="{{ asset('css/estilos.css') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body class="{{ app.user ? 'sesion-activa' : 'pagina-acceso' }}">
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {% if app.user %}
        <header class="cabecera">
            <a class="marca" href="{{ path('app_dashboard') }}">{{ include('shared/_logo.html.twig', {clase: 'logo-menu'}) }}<span>SICOJEV<small>Esperanza Viva</small></span></a>

            <nav aria-label="Menú principal">
                {% set ruta = app.request.attributes.get('_route') %}
                <span class="nav-etiqueta">ESPACIO DE TRABAJO</span>
                <a href="{{ path('app_dashboard') }}" {% if ruta == 'app_dashboard' %}aria-current="page"{% endif %}><span aria-hidden="true">⌂</span> Inicio</a>
                <a href="{{ path('app_actividad_index') }}" {% if ruta starts with 'app_actividad_' %}aria-current="page"{% endif %}><span aria-hidden="true">▦</span> Actividades</a>
            </nav>
            <div class="perfil">
                <span class="avatar" aria-hidden="true">{{ app.user.nombreCompleto|slice(0, 1)|upper }}</span>
                <div><strong>{{ app.user.nombreCompleto }}</strong><small>{{ app.user.rol.nombre }}</small></div>
                <a href="{{ logout_path() }}">Cerrar sesión</a>
            </div>
        </header>
    {% endif %}

    <main class="contenedor" id="contenido">
        {% if app.user %}<div class="barra-superior"><span>Sociedad de Jóvenes <span class="separador">/</span> Gestión</span><span class="insignia">Esperanza Viva</span></div>{% endif %}
        {% for tipo, mensajes in app.flashes %}
            {% for mensaje in mensajes %}
                <p class="aviso aviso-{{ tipo }}" role="status">{{ mensaje }}</p>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
        {% if app.user %}<footer>SICOJEV <span>Organizados para servir mejor.</span></footer>{% endif %}
    </main>
</body>
</html>
