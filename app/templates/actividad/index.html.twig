{% extends 'base.html.twig' %}

{% block title %}Actividad index{% endblock %}

{% block body %}
    <h1>Actividad index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>MotivoCancelación</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for actividad in actividads %}
            <tr>
                <td>{{ actividad.id }}</td>
                <td>{{ actividad.nombre }}</td>
                <td>{{ actividad.tipo }}</td>
                <td>{{ actividad.estado }}</td>
                <td>{{ actividad.motivoCancelación }}</td>
                <td>
                    <a href="{{ path('app_actividad_show', {'id': actividad.id}) }}">show</a>
                    <a href="{{ path('app_actividad_edit', {'id': actividad.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_actividad_new') }}">Create new</a>
{% endblock %}
