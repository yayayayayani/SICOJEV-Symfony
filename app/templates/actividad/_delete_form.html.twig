<form method="post" action="{{ path('app_actividad_delete', {'id': actividad.id}) }}" onsubmit="return confirm('¿Deseas eliminar esta actividad?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ actividad.id) }}">
    <button class="boton-peligro">Eliminar actividad</button>
</form>
