{% extends 'base.html.twig' %}

{% block title %}Actividad{% endblock %}

{% block body %}
    <h1>Actividad</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ actividad.id }}</td>
            </tr>
            <tr>
                <th>Nombre</th>
                <td>{{ actividad.nombre }}</td>
            </tr>
            <tr>
                <th>Tipo</th>
                <td>{{ actividad.tipo }}</td>
            </tr>
            <tr>
                <th>Estado</th>
                <td>{{ actividad.estado }}</td>
            </tr>
            <tr>
                <th>Motivo de cancelación</th>
                <td>{{ actividad.motivoCancelacion ?? '—' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_actividad_index') }}">Volver al listado</a>

    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_TESORERO') %}
        <a href="{{ path('app_actividad_edit', {'id': actividad.id}) }}">Editar</a>
        {{ include('actividad/_delete_form.html.twig') }}
    {% endif %}
{% endblock %}
